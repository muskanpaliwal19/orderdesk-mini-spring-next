{
  "services": {
    "frontend": { "cwd": "./frontend", "cmd": "npm", "args": ["run", "dev"], "port": 3000 },
    "backend": { "cwd": "./backend", "cmd": "sh", "args": ["-c", "./mvnw flyway:migrate && ./mvnw spring-boot:run -Dspring-boot.run.arguments=--server.port=8080"], "port": 8080, "healthCheck": { "path": "/api/actuator/health", "timeoutSeconds": 180 } }
  },
  "routes": {
    "/api": { "service": "backend", "stripPrefix": false },
    "/": { "service": "frontend", "stripPrefix": false }
  }
